# The worker only needs the Docker *client* library (docker-py talks to the
# daemon over the mounted socket) — no Docker-in-Docker, no dind image.
FROM python:3.11-slim

WORKDIR /srv

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app
COPY worker ./worker

CMD ["python", "-m", "worker.judge_worker"]
